// name, default, meaning (all registers are 32-bit words)
FIELD(ENABLE, 0, "0 disabled; 1 speed control")
FIELD(TARGET_MRPM, 0, "signed output-shaft milli-RPM")
FIELD(ENCODER_PPR, 0, "full pulses per channel per motor revolution")
FIELD(GEAR_NUM, 0, "gear reduction numerator")
FIELD(GEAR_DEN, 1, "gear reduction denominator")
FIELD(WHEEL_RADIUS_UM, 0, "effective wheel radius in micrometres; 0 unknown")
FIELD(ENCODER_SCALE_PPM, 1000000, "calibrated counts/revolution multiplier")
FIELD(COUNTS_PER_REV_Q16, 0, "derived x4 output-shaft counts/revolution, Q16.16")
FIELD(ENCODER_SIGN, 1, "+1 or -1; normalize forward motion")
FIELD(DRIVE_SIGN, 1, "+1 or -1; normalize bridge wiring")
FIELD(MAX_SPEED_MRPM, 0, "maximum output-shaft milli-RPM")
FIELD(MAX_ACCEL_MRPM_S, 0, "maximum target acceleration, milli-RPM/second")
FIELD(NOMINAL_VOLTAGE_MV, 0, "motor rated millivolts; metadata")
FIELD(CURRENT_LIMIT_MA, 0, "requested driver limit; 0 unspecified; requires driver support")
FIELD(PWM_HZ, 20000, "requested PWM carrier; platform shell applies")
FIELD(SAMPLE_HZ, 1000000, "requested encoder sample rate; platform shell applies")
FIELD(FILTER_SAMPLES, 5, "equal input samples required; platform shell applies")
FIELD(KP_Q16, 0, "duty/RPM proportional gain, Q16.16")
FIELD(KI_Q16, 0, "duty/(RPM second) integral gain, Q16.16")
FIELD(KD_Q16, 0, "duty second/RPM derivative gain, Q16.16")
FIELD(KFF_Q16, 0, "duty/RPM feedforward gain, Q16.16")
FIELD(D_ALPHA_Q16, 65536, "derivative filter weight, 0..65536")
FIELD(I_LIMIT_Q16, 65536, "absolute integral limit, normalized duty Q16.16")
FIELD(DUTY_LIMIT_Q16, 65536, "maximum output duty magnitude, Q16.16")
FIELD(PWM_GAIN_FWD_Q16, 65536, "positive effort calibration multiplier")
FIELD(PWM_GAIN_REV_Q16, 65536, "negative effort calibration multiplier")
FIELD(PWM_OFFSET_FWD_Q16, 0, "positive effort breakaway offset")
FIELD(PWM_OFFSET_REV_Q16, 0, "negative effort breakaway offset")
FIELD(SPEED_ALPHA_Q16, 8192, "count-window speed estimator filter weight")
FIELD(WATCHDOG_US, 100000, "maximum time between host keepalives")
FIELD(MAX_DELTA_COUNTS, 4096, "maximum plausible encoder delta per control tick")
